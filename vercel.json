{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { 
      "src": "api/generate.js", 
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
