rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // The browser does not need direct access to user/account data.
    // All account, usage, and payment writes go through your Vercel API
    // using the Firebase Admin SDK.
    match /users/{uid} {
      allow read, write: if false;
    }

    match /subscriptionRequests/{requestId} {
      allow read, write: if false;
    }
  }
}
