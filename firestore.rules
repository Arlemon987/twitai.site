rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // All account, usage, generation-log and payment writes go through
    // the Vercel API using Firebase Admin SDK.
    match /users/{uid} {
      allow read, write: if false;
    }

    match /subscriptionRequests/{requestId} {
      allow read, write: if false;
    }

    match /usageDaily/{usageId} {
      allow read, write: if false;
    }

    match /generationLogs/{generationId} {
      allow read, write: if false;
    }
  }
}
